# Derivatives the resize middleware writes on demand — regenerated on request,
# never a source of truth.
src/uploads/.resized/

src/uploads/images/*
src/uploads/videos/*
!src/uploads/images/.gitkeep
!src/uploads/videos/.gitkeep

# Scratch caches for the catalogue fetchers — re-fetched on demand.
.tsarbomba-cache/
.brand-cache/
