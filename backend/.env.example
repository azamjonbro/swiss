PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/swisswatch
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=src/uploads
CLIENT_URL=http://localhost:5173
# Canonical public origin used for sitemap URLs. In production this is the
# customer-facing domain, not the API host.
SITE_URL=https://swisspremium.uz
# Comma-separated list of origins allowed to call the API (storefront + admin panel).
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
