PORT=4000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/swisswatch
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
UPLOAD_DIR=src/uploads
CLIENT_URL=http://localhost:5173
# Canonical public origin used for sitemap URLs. In production this is the
# customer-facing domain, not the API host. REQUIRED: `npm run build` fails
# when it is missing or still points at localhost.
SITE_URL=https://swisswatchpremium.uz
# Comma-separated list of origins allowed to call the API (storefront + admin panel).
CORS_ORIGINS=http://localhost:5173,http://localhost:5175
# Vercel Deploy Hook for the STOREFRONT project. Catalog pages are prerendered
# at build time, so a product added through the admin panel has no static page
# until the next deploy; the backend pings this hook (debounced) after any
# create/update/delete on a Watch, Brand or Collection. Leave empty locally —
# an unset value makes the trigger a logged no-op.
VERCEL_DEPLOY_HOOK_URL=

# Timezone the admin analytics dashboard groups days by. Visits are stored in
# UTC; this only decides where one day ends and the next begins.
ANALYTICS_TIMEZONE=Asia/Tashkent

# ---- Cloudflare Turnstile (captcha) ----------------------------------------
# The SECRET key from Cloudflare dashboard -> Turnstile -> your widget.
# Its public partner, the site key, goes in frontend/.env as
# VITE_TURNSTILE_SITE_KEY — that one is meant to be visible; this one is not.
# Leave empty to disable captcha checks entirely (local development).
TURNSTILE_SECRET_KEY=
