# Base URL for the backend API when it is not served from the same origin
# (e.g. in production behind separate domains). Leave empty in development —
# the Vite dev server proxies /api, /uploads, and /sitemap.xml to the backend.
VITE_API_URL=

# Canonical origin used in <link rel=canonical>, Open Graph URLs, JSON-LD and
# the prerendered HTML. REQUIRED: a production build fails outright when this
# is missing, points at localhost, or points at a *.vercel.app preview host.
# Set it in the Vercel dashboard for BOTH Production and Preview.
VITE_SITE_URL=https://swisswatchpremium.uz

# Brand name used in page titles and structured data. A proper noun — it is
# spelled the same way in Uzbek, Russian and English.
VITE_SITE_NAME=SwissWatch Premium

# Published contact address. LEAVE EMPTY until the business has a real, public
# one: empty renders nothing in the UI (no placeholder) and omits the field from
# the JSON-LD entirely. It is presented as the company director's own address,
# not a shared inbox — see the `contact.ceoEmail` label.
#
# The telephone numbers are NOT set here. They are static, in CONTACT_PHONES in
# src/seo/schema.mjs, so changing them is a commit rather than a dashboard edit.
VITE_CONTACT_EMAIL=

# Whether the storefront publishes prices at all. Empty (the default) hides
# every figure — catalogue, product page, search, cart — hides the currency
# selector and the price filters and sorts with them, and drops the Offer node
# from the product JSON-LD so the markup cannot contradict the page. Set to 1
# to put them all back. See src/config/pricing.ts.
VITE_SHOW_PRICES=

# Build-time only: where the prerenderer reads the catalog from, and the
# language its crawlable copy is written in.
SEO_API_URL=https://swiss.sds-max.uz
SEO_LANG=en

# Cloudflare Turnstile SITE key (public — it ships in the bundle by design).
# Its partner, the SECRET key, belongs only in backend/.env as
# TURNSTILE_SECRET_KEY. Leave empty to render no captcha at all.
VITE_TURNSTILE_SITE_KEY=
