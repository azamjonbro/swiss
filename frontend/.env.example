# Base URL for the backend API when it is not served from the same origin
# (e.g. in production behind separate domains). Leave empty in development —
# the Vite dev server proxies /api, /uploads, and /sitemap.xml to the backend.
VITE_API_URL=

# NOT set here, and not in the Vercel dashboard either: the canonical origin,
# the site name, the contact email, the telephone numbers and the catalog origin
# the build reads from are all constants in src/seo/schema.mjs
# (DEFAULT_SITE_URL, SITE_NAME, CONTACT_EMAIL, CONTACT_PHONES, API_ORIGIN).
#
# They used to be VITE_SITE_URL / VITE_SITE_NAME / VITE_CONTACT_* / SEO_API_URL.
# Every one of them went stale in the dashboard at least once, and a stale value
# there is invisible from the repository: the phone number stayed wrong for
# days, and SEO_API_URL pointed at a decommissioned host long enough that no
# product page was prerendered at all. Changing any of them is now a commit.

# Whether the storefront publishes prices at all. Empty (the default) hides
# every figure — catalogue, product page, search, cart — hides the currency
# selector and the price filters and sorts with them, and drops the Offer node
# from the product JSON-LD so the markup cannot contradict the page. Set to 1
# to put them all back. See src/config/pricing.ts.
VITE_SHOW_PRICES=

# Build-time only: the language the prerenderer writes its crawlable copy in.
# The catalog origin it reads from is API_ORIGIN in src/seo/schema.mjs.
SEO_LANG=en

# Cloudflare Turnstile SITE key (public — it ships in the bundle by design).
# Its partner, the SECRET key, belongs only in backend/.env as
# TURNSTILE_SECRET_KEY. Leave empty to render no captcha at all.
VITE_TURNSTILE_SITE_KEY=
