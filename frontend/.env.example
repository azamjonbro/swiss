# Base URL for the backend API when it is not served from the same origin
# (e.g. in production behind separate domains). Leave empty in development —
# the Vite dev server proxies /api, /uploads, and /sitemap.xml to the backend.
VITE_API_URL=

# Canonical origin used in <link rel=canonical>, Open Graph URLs, JSON-LD and
# the prerendered HTML. Defaults to the production domain so a preview build
# can never emit localhost or a *.vercel.app URL into indexable metadata.
VITE_SITE_URL=https://swisspremium.uz

# Brand name used in page titles and structured data.
VITE_SITE_NAME=Swiss Premium

# Build-time only: where the prerenderer reads the catalog from, and the
# language its crawlable copy is written in.
SEO_API_URL=https://swiss.techinfo.uz
SEO_LANG=en
